FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY src/ ./src/
COPY content/ ./content/
RUN dotnet restore src/Beep.OilGasSim.Api/Beep.OilGasSim.Api.csproj
RUN dotnet publish src/Beep.OilGasSim.Api/Beep.OilGasSim.Api.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:9.0
WORKDIR /app
COPY --from=build /app/publish .
COPY --from=build /src/content ./content
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "Beep.OilGasSim.Api.dll"]

; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OilfieldDays"
run/main_scene="res://scenes/Splash.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://assets/brand/logo.png"

[autoload]

EngineHost="*res://game/Host/EngineHost.cs"
SceneRouter="*res://game/App/SceneRouter.cs"
SimulationController="*res://game/Host/SimulationController.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="OilfieldDays"

[editor]

export/convert_text_resources_to_binary=false

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

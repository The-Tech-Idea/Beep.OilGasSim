{
  "version": 7,
  "environment": "Desert",
  "tile_size": [
    256,
    128
  ],
  "projection": "2:1 isometric",
  "source": "original_generated_sheet_not_previous_normalized_tiles",
  "critical_fix": "Removed generated smooth perimeter completely. Base texture is synthesized from an interior detailed patch and remains textured through every side and corner.",
  "rules": {
    "smooth_internal_margin": false,
    "detail_reaches_sides_and_corners": true,
    "cross_variant_boundary_match": true,
    "periodic_lattice_texture": true,
    "edge_overdraw_px": 1,
    "flat_top_only": true,
    "sidewalls": false,
    "baked_shadow": false
  },
  "godot": {
    "filter": "Nearest",
    "mipmaps": false,
    "atlas_margin": 0,
    "atlas_spacing": 0,
    "scale_mode": "integer"
  }
}
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- SDD-000 §1: test assemblies may take packages; engine assemblies may not.
         Roslyn resolves open item S000-2 for the checks where source syntax is
         the subject (a catch clause, a numeric literal, an await). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OGSim.Contracts\OGSim.Contracts.csproj" />
    <ProjectReference Include="..\..\src\OGSim.Kernel\OGSim.Kernel.csproj" />
    <ProjectReference Include="..\..\src\OGSim.Flow\OGSim.Flow.csproj" />
    <ProjectReference Include="..\..\src\OGSim.Wells\OGSim.Wells.csproj" />
    <ProjectReference Include="..\..\src\OGSim.Facilities\OGSim.Facilities.csproj" />
    <ProjectReference Include="..\..\src\OGSim.Operations\OGSim.Operations.csproj" />
    <ProjectReference Include="..\..\src\OGSim.Company\OGSim.Company.csproj" />
    <ProjectReference Include="..\..\src\OGSim.Information\OGSim.Information.csproj" />
    <!-- Referenced so the assembly is present to INSPECT, not to use: every
         type in OGSim.Subsurface is internal, which is the thing R5-V-truth
         checks. -->
    <ProjectReference Include="..\..\src\OGSim.Subsurface\OGSim.Subsurface.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>OGSim.Subsurface.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only assembly with InternalsVisibleTo from OGSim.Subsurface
         (SDD-000: a module's own test assembly, and nothing else). -->
    <ProjectReference Include="..\..\src\OGSim.Subsurface\OGSim.Subsurface.csproj" />
    <!-- StateBlock, so the compartment round-trips through the REAL canonical
         writer rather than a double that could agree with a bug. -->
    <ProjectReference Include="..\..\src\OGSim.Persistence\OGSim.Persistence.csproj" />
  </ItemGroup>

</Project>
